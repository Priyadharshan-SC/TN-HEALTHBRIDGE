# =============================================================================
# TN HealthBridge — Environment Configuration Template
# Copy to .env for local development overrides
# =============================================================================

# Application Metadata
ENVIRONMENT=development
PROJECT_NAME="TN HealthBridge"
API_V1_PREFIX=/api/v1

# Ingestion Constraints (M1)
# Maximum upload size in bytes (default: 1048576 = 1 MB)
MAX_UPLOAD_SIZE_BYTES=1048576

# Maximum record count per ingestion batch (default: 1000)
MAX_RECORD_COUNT=1000

# Normalization Constraints (M2)
# Maximum record count per normalization batch (default: 1000)
MAX_NORMALIZATION_RECORD_COUNT=1000

# Terminology Mapping Constraints (M3)
# Maximum record count per terminology mapping batch (default: 1000)
MAX_TERMINOLOGY_RECORD_COUNT=1000

# Patient Identity Safety Constraints (M4)
# Maximum comparison count per identity assessment batch (default: 1000)
MAX_IDENTITY_RECORD_COUNT=1000

# Provider Allowlist (comma-separated list for simulation)
ALLOWED_PROVIDERS=HOSPITAL_A,HOSPITAL_B,LAB_C

# Health Information User (HIU) Allowlist
ALLOWED_HIUS=HIU_TN_001,HIU_TN_002,HOSPITAL_B,HOSPITAL_A

# Authoritative Synthetic Identity Fixture Registry Path (M4)
SYNTHETIC_IDENTITY_REGISTRY_PATH=data/identity/synthetic_identity_registry.json

# FHIR Assembly Constraints (M5)
MAX_FHIR_RECORD_COUNT=1000

# ABDM Consent & Security Gateway Constraints (M6)
ALLOW_TEST_SIGNATURES=false
CONSENT_STORE_PATH=data/gateway/consent_registry.json
MAX_CONSENT_VALIDITY_DAYS=180
MAX_CLOCK_DRIFT_MINUTES=5

# Application Authentication & Cryptography (Never commit real secrets)
JWT_SECRET_KEY=replace-with-a-secure-random-32-char-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Healthcare Data Exchange (M7)
EXCHANGE_STORE_PATH=data/exchange/exchange_jobs.json
MAX_EXCHANGE_RECORD_COUNT=1000
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.5

# Security Audit Logging
AUDIT_LOG_PATH=data/audit/audit_events.jsonl
